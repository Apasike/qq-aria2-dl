# ============================================================
# qq-aria2-dl configuration
# Copy this file to `.env` and fill in your own values.
# ============================================================

# ---------- App ----------
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

# ---------- OneBot v11 (NapCat reverse websocket) ----------
ONEBOT_PATH=/onebot/v11/ws
ONEBOT_TOKEN=please-change-me
ONEBOT_HEARTBEAT_TIMEOUT_SEC=90
ONEBOT_SEND_TIMEOUT_SEC=10

# ---------- aria2 JSON-RPC ----------
# URL 指向你服务器上的 aria2 RPC，端口和 secret 要和 aria2 一致。
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_SECRET=please-change-me
ARIA2_POLL_INTERVAL_SEC=2

# 下载目录：留空则使用 aria2 自己配置的默认目录（推荐）。
ARIA2_DOWNLOAD_DIR=
ARIA2_MAX_CONCURRENT=3
ARIA2_SPLIT=1
ARIA2_MAX_CONNECTION_PER_SERVER=1

# ---------- Progress query ----------
PROGRESS_CACHE_TTL_SEC=5
PROGRESS_QUERY_COOLDOWN_SEC=3
PROGRESS_RPC_CACHE_SEC=2
PROGRESS_MAX_TASKS_PER_QUERY=5

# ---------- SQLite ----------
STORAGE_DB_PATH=data/bot.db
STORAGE_TASK_RETENTION_DAYS=30

# ---------- Dedupe ----------
# scope: chat | global | user
DEDUPE_TTL_SEC=600
DEDUPE_SCOPE=chat

# ---------- Disk guard (only used when ARIA2_DOWNLOAD_DIR is local) ----------
DISK_MIN_FREE_BYTES=5368709120
DISK_MIN_FREE_PERCENT=10
DISK_CRITICAL_FREE_BYTES=2147483648
DISK_UNKNOWN_SIZE_RESERVE_BYTES=536870912
DISK_HEAD_TIMEOUT_SEC=5
DISK_AUTO_RESUME=false

# ---------- Rate limit (per 10 minutes) ----------
RATE_LIMIT_PER_USER_PER_10MIN=3
RATE_LIMIT_PER_GROUP_PER_10MIN=10

# ---------- Download whitelist ----------
# 允许使用 /dl、/progress、/cancel 等命令的 QQ 号，逗号分隔。
# 留空后可用管理员命令 /wl add <qq> 动态添加（持久化到 SQLite）。
DOWNLOAD_ALLOWED_USERS=

# ---------- Global admins ----------
# 管理员可以管理下载白名单（/wl add、/wl del）。
ADMIN_USERS=

# ---------- Group auto-download switch (JSON) ----------
# 下载权限由 DOWNLOAD_ALLOWED_USERS 控制；此处只控制某群是否开启自动下载。
GROUPS={"123456":{"enabled":true,"auto_download":true,"require_at":false,"allowed_users":[],"max_urls_per_message":3}}

# ---------- URL safety ----------
ALLOWED_SCHEMES=http,https
MAX_URL_LENGTH=8192
DOWNLOAD_USER_AGENT=
DOWNLOAD_REFERER=